# Production Environment Configuration Template
# Copy this file to .env.production before running docker-compose:
#   cp .env.production.example .env.production

APP_ENV=production
DEBUG=false
PROJECT_NAME="Transformer AI Monitoring & Predictive Maintenance"
VERSION="1.0.0"

# MANDATORY: Generate a unique 64-character hex secret for physical ESP32 authentication:
# Python (cross-platform): python -c "import secrets; print(secrets.token_hex(32))"
# Or (Linux/Mac): openssl rand -hex 32
DEVICE_API_KEY=replace_with_strong_random_secret_generated_on_deployment

# SQLite Persistent Database Location inside Container
DATABASE_URL=sqlite:////app/data/transformer_monitoring.db

# Distributed Background Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_CHECK_INTERVAL_SECONDS=60
SCHEDULER_GRACE_PERIOD_MINUTES=5
SCHEDULER_LOCK_TIMEOUT_MINUTES=15

# Permitted Web Dashboard CORS Origins (Substation Local IP, VPN, or Domain)
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]

