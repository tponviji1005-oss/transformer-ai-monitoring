# Backend Configuration
PROJECT_NAME="Transformer AI Monitoring"
APP_ENV=development
API_V1_PREFIX=/api
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///data/transformer_monitoring.db

# Device Authentication
# Secret API key required in the 'X-Device-API-Key' header for telemetry ingestion
DEVICE_API_KEY=dev-transformer-secret-key-change-in-prod

# Hourly Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_CHECK_INTERVAL_SECONDS=60
SCHEDULER_GRACE_PERIOD_MINUTES=5
SCHEDULER_LOCK_TIMEOUT_MINUTES=15

